{
  "name": "arka-plan-kaldir",
  "productName": "Arka Plan Kaldır",
  "version": "1.2.0",
  "description": "Fotoğraflara sağ tıklayıp arka planı kaldır, renk ekle ve yeni fotoğraf olarak kaydet.",
  "main": "main.js",
  "private": true,
  "author": "Arka Plan Kaldır",
  "license": "AGPL-3.0",
  "scripts": {
    "start": "electron .",
    "ikon": "node tools/ikon-uret.mjs",
    "kur": "node tools/kur.mjs",
    "paket": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.arkaplankaldir.uygulama",
    "productName": "Arka Plan Kaldır",
    "copyright": "Arka Plan Kaldır",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "lib/**/*",
      "assets/**/*",
      "package.json",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/win32/x64/DirectML.dll",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/win32/x64/dxcompiler.dll",
      "!**/node_modules/@img/sharp-darwin-*/**",
      "!**/node_modules/@img/sharp-linux-*/**",
      "!**/node_modules/@img/sharp-linuxmusl-*/**",
      "!**/node_modules/@img/sharp-wasm32/**"
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "ArkaPlanKaldir",
      "artifactName": "ArkaPlanKaldir-Kurulum-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Arka Plan Kaldır",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "uninstallDisplayName": "Arka Plan Kaldır",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "onnxruntime-node": "1.31.1",
    "sharp": "0.34.4"
  }
}
